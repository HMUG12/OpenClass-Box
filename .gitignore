# ── PyInstaller 打包 ──
build/
dist/
*.spec
build*.txt
build_pkg.py
OpenClass_Setup.exe

# ── Python 缓存 ──
__pycache__/
*.py[cod]
*.egg-info/

# ── IDE / 编辑器 ──
.vscode/
.idea/
*.swp
*.swo

# ── 数据库 & 密钥（含加密密钥文件） ──
data/*.db
data/*.db-*
data/.keyfile
app/data/
plugins/*/schedule_data.json

# ── 日志 ──
logs/
*.log

# ── 系统垃圾 ──
.DS_Store
Thumbs.db

# ── 虚拟环境 ──
venv/
.venv/
env/

# ── 前端依赖与构建产物 ──
frontend/node_modules/
frontend/.vite/
frontend/package-lock.json

# ── 运行时数据（便携模式下跟随程序目录生成） ──
data/

# ── 打包产物与便携工具（体积大，不入库）──
dist_build/
build_build/
tools/
installer/
installer_iscc.log
installer_iscc.err
third_party/

*.log

runtime/
tools/mpv/
signing/
frontend/vite.config.ts.timestamp-*

# 本地发布产物（安装包体积大，不随仓库分发）
release/

# playwright-cli 的临时产物（浏览器实测时生成）
nav.yaml
.playwright-cli/
